{%- set cat = categories | findCategory(post.data.category) %}
<article class="card">
  {% if post.data.image %}<a class="card-img" href="{{ post.url }}"><img src="{{ post.data.image }}" alt="" loading="lazy"></a>{% endif %}
  <div class="card-body">
    {% if cat %}<a class="pill pill-{{ cat.slug }}" href="/category/{{ cat.slug }}/">{{ cat.name }}</a>{% endif %}
    <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
    {% if post.data.excerpt %}<p>{{ post.data.excerpt }}</p>{% endif %}
    <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
  </div>
</article>
